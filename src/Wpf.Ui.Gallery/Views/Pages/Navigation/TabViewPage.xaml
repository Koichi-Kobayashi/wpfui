<Page
    x:Class="Wpf.Ui.Gallery.Views.Pages.Navigation.TabViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.Navigation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TabViewPage"
    d:DataContext="{d:DesignInstance local:TabViewPage, IsDesignTimeCreatable=False}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample HeaderText="Document tabs." XamlCode="&lt;ui:TabView&gt;&#10;    &lt;ui:TabViewItem Header=&quot;Welcome&quot; IsClosable=&quot;False&quot; /&gt;&#10;&lt;/ui:TabView&gt;">
            <ui:TabView Margin="0,8,0,0" TabAdding="OnTabAdding">
                <ui:TabViewItem Header="Welcome" IsClosable="False" IsSelected="True">
                    <TextBlock Margin="12" Text="Use + to add a document. Drag a header to reorder tabs." />
                </ui:TabViewItem>
                <ui:TabViewItem Header="Document 2">
                    <TextBlock Margin="12" Text="Use the close button to close this document." />
                </ui:TabViewItem>
            </ui:TabView>
        </controls:ControlExample>
        <controls:ControlExample Margin="0,24,0,0" HeaderText="MVVM: ObservableCollection of document models." XamlCode="&lt;ui:TabView ItemsSource=&quot;{Binding Documents}&quot;&#10;    SelectedItem=&quot;{Binding SelectedDocument, Mode=TwoWay}&quot;&#10;    TabAdding=&quot;OnModelTabAdding&quot; /&gt;">
            <ui:TabView Margin="0,8,0,0"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                        TabAdding="OnModelTabAdding"
                        TabClosing="OnModelTabClosing">
                <ui:TabView.ItemContainerStyle>
                    <Style TargetType="ui:TabViewItem" BasedOn="{StaticResource {x:Type ui:TabViewItem}}">
                        <Setter Property="Header" Value="{Binding Header}" />
                        <Setter Property="IsClosable" Value="{Binding IsClosable}" />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Margin="12" Text="{Binding Content}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ui:TabView.ItemContainerStyle>
            </ui:TabView>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Tab groups proof of concept (MVVM)."
            XamlCode="&lt;ui:TabView ItemsSource=&quot;{Binding GroupedDocuments}&quot; TabGroups=&quot;{Binding Groups}&quot; /&gt;">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Drag a group header to move all its tabs before or after another group or an ungrouped tab, even when collapsed. A short click still expands or collapses the group. Drag to either side of a tab to reorder or change its group. Drop on a colored group header to append, even when collapsed. Drop on Home or Notes to ungroup. The insertion line or header outline indicates an allowed drop; Esc cancels. Collapse a group to keep its selected document open." />
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,0,16,0" Content="{Binding Header}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Right-click a group header to edit its name and color, ungroup its tabs, or add a new tab to that group. Try selecting a Development tab, then right-click Reference and choose Add new tab to this group: the new tab appears at the end of Reference, even when collapsed. The + button still adds after the selected tab. Right-click a tab to create a group, change its group, or remove its membership. Enter applies the editor; Escape cancels. Moving the last tab out hides the old header but retains its definition. Disabled commands indicate read-only data or bindings." />
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Add a long tab row" Command="{Binding AddLongTabRowCommand}" />
                    <Button Margin="8,0,0,0" Content="Remove extra tabs" Command="{Binding RemoveExtraGroupedTabsCommand}" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Colored regions distinguish Development and Reference from ungrouped tabs. The + button adds after the selected tab and uses its group; Home and Notes create ungrouped tabs. A collapsed destination expands after the new tab is added. Add long tabs to show the scroll arrows; use the mouse wheel over the strip. Remove extras or collapse both groups to hide the arrows. Use the Gallery theme selector to compare Light and Dark." />
                <TextBlock Margin="0,8,0,8" TextWrapping="Wrap"
                           Text="Keyboard: Tab / Shift+Tab access group headers. Left / Right move through visible tabs and headers; Home / End reach the strip ends. Enter / Space expand or collapse a focused group without changing its selected document. Ctrl+Tab / Ctrl+Shift+Tab select the next / previous visible tab. Offscreen headers scroll into view. In the editor, Enter applies and Escape cancels. Narrator: press Windows+Ctrl+Enter, focus a group header, and check its name and expanded / collapsed state; collapsed groups keep the selected document open." />
                <ui:TabView
                    Margin="0,8,0,0"
                    ItemsSource="{Binding GroupedDocuments}"
                    SelectedItem="{Binding SelectedGroupedDocument, Mode=TwoWay}"
                    TabGroups="{Binding Groups}"
                    TabAdding="OnGroupedTabAdding"
                    TabClosing="OnModelTabClosing">
                    <ui:TabView.ItemContainerStyle>
                        <Style TargetType="ui:TabViewItem" BasedOn="{StaticResource {x:Type ui:TabViewItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="IsClosable" Value="{Binding IsClosable}" />
                            <Setter Property="GroupId" Value="{Binding GroupId, Mode=TwoWay}" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Margin="12" Text="{Binding Content}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ui:TabView.ItemContainerStyle>
                </ui:TabView>
                <Expander Header="ViewModel group membership" Margin="0,8,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Header}" Width="180" />
                                        <TextBlock Text="{Binding Color}" Width="120" />
                                        <TextBlock Text="{Binding Id}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding GroupedDocuments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Header}" Width="180" />
                                        <TextBlock Text="{Binding GroupId, TargetNullValue='Ungrouped'}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Tab groups with read-only membership."
            XamlCode="&lt;Setter Property=&quot;GroupId&quot; Value=&quot;{Binding GroupId, Mode=OneWay}&quot; /&gt;">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="These same models use OneWay membership bindings here. Reordering within a group and moving a whole group by its header are allowed; changing an individual tab to another group is rejected with the no-drop cursor. Try the writable group sample above to move tabs between groups." />
                <ui:TabView Margin="0,8,0,0" CanAddTabs="False"
                            ItemsSource="{Binding GroupedDocuments}" TabGroups="{Binding Groups}">
                    <ui:TabView.ItemContainerStyle>
                        <Style TargetType="ui:TabViewItem" BasedOn="{StaticResource {x:Type ui:TabViewItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="IsClosable" Value="False" />
                            <Setter Property="GroupId" Value="{Binding GroupId, Mode=OneWay}" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Margin="12" Text="{Binding Content}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ui:TabView.ItemContainerStyle>
                </ui:TabView>
            </StackPanel>
        </controls:ControlExample>
    </StackPanel>
</Page>
